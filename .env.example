# Browser configuration for the Vite build.
#
# Only these two variables may ever appear in the frontend bundle. They are
# publishable values - real protection comes from Postgres Row Level Security.
#
# Copy this file to `.env` and fill in the values from:
#   Supabase Dashboard > Project Settings > API keys
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# NEVER put OPENAI_API_KEY, SUPABASE_SERVICE_ROLE_KEY or SUPABASE_SECRET_KEY
# in this file. Those are Edge Function secrets - see README.
